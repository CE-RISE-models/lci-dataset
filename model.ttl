            owl:minCardinality 0 ;
            owl:onProperty dqf:criterion_weight_value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dqf:criterion_impact_value ],
        [ a owl:Restriction ;
