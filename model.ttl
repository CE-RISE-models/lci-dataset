            owl:maxCardinality 1 ;
            owl:onProperty dqf:provenance_description_value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dqf:temporal_coverage_value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dqf:update_frequency_value ],
