            owl:onProperty dqf:criterion_rationale_value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty dqf:criterion_impact_value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
