            owl:onProperty uq:numeric_value_value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty uq:value_type_value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty uq:value_source_value ],
